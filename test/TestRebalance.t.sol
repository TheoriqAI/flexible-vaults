pragma solidity 0.8.25;

import "forge-std/Test.sol";
import "forge-std/console2.sol";

interface IAaveLikePool {
    function getUserAccountData(address user)
        external
        view
        returns (
            uint256 totalCollateralBase,
            uint256 totalDebtBase,
            uint256 availableBorrowsBase,
            uint256 currentLiquidationThreshold,
            uint256 ltv,
            uint256 healthFactor
        );
}

contract HFCheckTest is Test {
    // ---- Constants you provided ----
    string internal constant MAINNET_RPC = "https://rpc.mevblocker.io";

    address internal constant USER = 0x36d8d9fC89eEB1aBbfc6101Cc23945e79416D9f3;
    //address internal constant USER = 0xB747b828A22001cAC25243C18408697845C3B68E;

    // Spark pool
    address internal constant SPARK_POOL = 0xC13e21B648A5Ee794902342038FF3aDAB66BE987;

    // Aave v3 pool
    address internal constant AAVE_POOL = 0x87870Bca3F3fD6335C3F4ce8392D69350B4fA4E2;

    // Safe that will execute the calldata
    address internal constant SAFE = 0xcca5BafEa783B0Ed8D11FD6D9F97c155332A16b8;

    // HF threshold: 1.03 (assumed WAD = 1e18)
    uint256 internal constant MIN_HF_WAD = 1_03e16; // 1.03e18 == 103e16; but let's do it explicitly below

    function setUp() external {
        vm.createSelectFork(MAINNET_RPC);
    }

    function test_HF_before_after_safe_call() external {
        // ---- Before ----
        uint256 sparkHfBefore = _getHealthFactor(SPARK_POOL, USER);
        uint256 aaveHfBefore  = _getHealthFactor(AAVE_POOL, USER);

        console2.log("==== BEFORE ====");
        _logHF("Spark HF", sparkHfBefore);
        _logHF("Aave  HF", aaveHfBefore);

        // ---- Execute arbitrary calldata as the Safe ----
        address target = SAFE;
        bytes memory data = hex"";
        address sender = 0x96ACD1963B5D65a87E4402909e585AF06c93d3C9;
        vm.prank(sender);
        (bool ok, bytes memory ret) = target.call(data);

        // Optional: surface revert reason / return data if it fails
        if (!ok) {
            console2.log("Safe call FAILED");
            console2.logBytes(ret);
            fail();
        } else {
            console2.log("Safe call OK");
            // console2.logBytes(ret); // uncomment if you expect return data
        }

        // ---- After ----
        uint256 sparkHfAfter = _getHealthFactor(SPARK_POOL, USER);
        uint256 aaveHfAfter  = _getHealthFactor(AAVE_POOL, USER);

        console2.log("==== AFTER ====");
        _logHF("Spark HF", sparkHfAfter);
        _logHF("Aave  HF", aaveHfAfter);

        // ---- Assert HF >= 1.03 ----
        uint256 min = 1_030_000_000_000_000_000; // 1.03e18

        assertGe(sparkHfAfter, min, "Spark HF < 1.03");
        assertGe(aaveHfAfter,  min, "Aave HF < 1.03");
    }

    function _getHealthFactor(address pool, address user) internal view returns (uint256 hf) {
        (, , , , , hf) = IAaveLikePool(pool).getUserAccountData(user);
    }

    function _logHF(string memory label, uint256 hfWad) internal {
        // Print raw + human-ish (integer + 2 decimals)
        console2.log(label);
        console2.log("  raw (wad):", hfWad);

        uint256 whole = hfWad / 1e18;
        uint256 frac2 = (hfWad % 1e18) / 1e16; // 2 decimals
        frac2 < 10 ? console2.log("  approx:",whole,".0",frac2) : console2.log("  approx:", whole, ".", frac2);
    }
}
