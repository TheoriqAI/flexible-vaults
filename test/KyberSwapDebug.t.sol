pragma solidity 0.8.25;

import {Test} from "forge-std/Test.sol";
import {console} from "forge-std/console.sol";
import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";

contract KyberSwapDebugTest is Test {
    address constant CALLER = 0xcf084a121A0eE1B769Dd38d07b8BdED36f889331;
    address constant KYBER_ROUTER = 0x6131B5fae19EA4f9D964eAc0408E4408b66337b5;

    function setUp() public {
        // Fork Base at specific block
        vm.createSelectFork("https://mainnet.base.org", 42242379);
    }

    function test_KyberSwapCall() public {
        console.log("=== KyberSwap Debug ===");
        console.log("Caller:", CALLER);
        console.log("Router:", KYBER_ROUTER);
        console.log("Block:", block.number);
        console.log("Caller ETH balance:", CALLER.balance);

        // The raw calldata split into parts (selector: 0xe21fd0e9 = swapGeneric)
        bytes memory part1 = hex"";

        bytes memory part2 = hex"";

        bytes memory part3 = hex"";

        bytes memory part4 = hex"";

        bytes memory part5 = hex"";

        bytes memory callData = bytes.concat(part1, part2, part3, part4, part5);

        console.log("Calldata length:", callData.length);
        console.log("Function selector:");
        console.logBytes4(bytes4(callData));

        // Check USDC balance and approval
        address USDC = 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913;
        address WETH = 0x4200000000000000000000000000000000000006;

        uint256 usdcBalance = IERC20(USDC).balanceOf(CALLER);
        uint256 wethBalance = IERC20(WETH).balanceOf(CALLER);
        uint256 usdcAllowance = IERC20(USDC).allowance(CALLER, KYBER_ROUTER);

        console.log("\nUSDC balance:", usdcBalance);
        console.log("WETH balance:", wethBalance);
        console.log("USDC allowance to router:", usdcAllowance);

        // Make the call with explicit gas
        vm.prank(CALLER);
        (bool success, bytes memory result) = KYBER_ROUTER.call{gas: 1000000}(callData);

        console.log("\nSuccess:", success);

        if (success) {
            console.log("Result length:", result.length);
            if (result.length > 0) {
                console.log("Result:");
                console.logBytes(result);
                // Try to decode as (uint256, uint256) for returnAmount, gasUsed
                if (result.length >= 64) {
                    (uint256 returnAmount, uint256 gasUsed) = abi.decode(result, (uint256, uint256));
                    console.log("Return amount:", returnAmount);
                    console.log("Gas used:", gasUsed);
                }
            }
        } else {
            console.log("\n=== REVERT ===");
            console.log("Revert data length:", result.length);
            if (result.length > 0) {
                console.log("Raw revert data:");
                console.logBytes(result);

                // Try to decode error
                if (result.length >= 4) {
                    bytes4 selector;
                    assembly {
                        selector := mload(add(result, 32))
                    }
                    console.log("\nError selector:");
                    console.logBytes4(selector);

                    // Check for Error(string) - 0x08c379a0
                    if (selector == 0x08c379a0 && result.length >= 68) {
                        assembly {
                            result := add(result, 4)
                        }
                        string memory errorMsg = abi.decode(result, (string));
                        console.log("Error(string):", errorMsg);
                    }
                    // Check for Panic(uint256) - 0x4e487b71
                    else if (selector == 0x4e487b71 && result.length >= 36) {
                        assembly {
                            result := add(result, 4)
                        }
                        uint256 panicCode = abi.decode(result, (uint256));
                        console.log("Panic code:", panicCode);
                    }
                }
            } else {
                console.log("Empty revert (no data)");
            }
        }
    }
}
